# Force LF line endings for shell scripts (prevent CRLF on Windows checkout)
scripts/*.sh text eol=lf
*.sh         text eol=lf
Dockerfile*  text eol=lf
# Lockfiles persistidos de Reflex: LF forzado. Con CRLF, bun.lock cambia de hash
# y el install --frozen-lockfile falla en prod (build desde checkout limpio).
reflex.lock/bun.lock     text eol=lf
reflex.lock/package.json text eol=lf
